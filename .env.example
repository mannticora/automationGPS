# ========================================
# .env.example - Configuración del Proyecto
# ========================================
# INSTRUCCIÓN: Copiar este archivo a .env y completar los valores.
# ADVERTENCIA: NUNCA hacer commit de .env con valores reales.

# ========================================
# PLATAFORMA DE CENSO DE BATERÍAS
# ========================================
CENSO_URL=https://censobaterias.pricepointmonitor.com/
CENSO_EMAIL=tu_email@ejemplo.com
CENSO_PASSWORD=tu_password_aqui

# ========================================
# GOOGLE MAPS (Opcional - habilita el modo API en vez de scraping)
# ========================================
# Si usas API: obtén tu key en https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SEARCH_RADIUS=500

# ========================================
# CONFIGURACIÓN DE RPA (Playwright)
# ========================================
HEADLESS_MODE=true
TIMEOUT_SEGUNDOS=60
MAX_REINTENTOS=3
SCREENSHOT_ON_ERROR=true
BROWSER_TYPE=chromium

# ========================================
# CONFIGURACIÓN DE LOGS
# ========================================
LOG_LEVEL=INFO
LOG_FILE=logs/automation.log
LOG_MAX_SIZE_MB=50

# ========================================
# CONFIGURACIÓN DE OUTPUT
# ========================================
OUTPUT_DIR=output/
EXCEL_FILENAME_PATTERN=reporte_validaciones_%Y%m%d_%H%M%S.xlsx
INCLUDE_SCREENSHOTS=false

# ========================================
# CONFIGURACIÓN DE PROCESAMIENTO
# ========================================
CASOS_PROCESADOS_LIMITE=100
DELAY_ENTRE_CASOS=2
DELAY_GOOGLE_MAPS=1

# ========================================
# FILTROS INICIALES
# ========================================
# La plataforma muestra el estado en español: pendiente | revisada
FILTRO_ESTADO=pendiente
ORDEN_POR=case_id
ORDEN_ASCENDENTE=true

# ========================================
# AMBIENTE
# ========================================
AMBIENTE=development
DEBUG=false
